# ============================================
# GymPro Frontend — Base Environment Variables
# ============================================
# Loaded in ALL modes. Values here are overridden by:
#   .env.development  → when running `npm run dev`
#   .env.production   → when running `npm run build`
#
# All env vars MUST start with VITE_ to be exposed to the frontend.

# App environment
VITE_APP_ENV=development

# Backend API server URL (without /api/v1)
VITE_BACKEND_URL=http://localhost:5000

# Full API base URL (with /api/v1)
VITE_API_URL=http://localhost:5000/api/v1

# Frontend dev server port
VITE_PORT=3005

# Enable debug logs in console (true/false)
VITE_ENABLE_DEBUG=true

# App title shown in browser tab
VITE_APP_TITLE=GymPro
