# ============================================
# GymPro Frontend — Environment Variables
# ============================================
# Single .env file used for ALL environments.
# All env vars MUST start with VITE_ to be exposed to the frontend.
#
# For LOCAL development: comment out production values, uncomment dev values.
# For VPS / production: keep production values active (default below).
# ============================================

# App environment
VITE_APP_ENV=production

# ── Backend URL (without /api/v1) ──────────────────────────────────────────
# Production (VPS):
VITE_BACKEND_URL=https://gymdeskpro.in
# Local development (uncomment & comment above):
# VITE_BACKEND_URL=http://localhost:5000

# ── Full API base URL (with /api/v1) ───────────────────────────────────────
# Production (VPS):
VITE_API_URL=https://api.gymdeskpro.in/api/v1
# Local development (uncomment & comment above):
# VITE_API_URL=http://localhost:5000/api/v1

# Frontend dev server port
VITE_PORT=3005

# Enable debug logs in console (true/false)
# Production: false | Local: true
VITE_ENABLE_DEBUG=false

# App title shown in browser tab
VITE_APP_TITLE=GymPro
