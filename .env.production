# ============================================
# GymPro Frontend — PRODUCTION Environment
# ============================================
# This file is loaded by Vite when running `npm run build`
#
# >>> CHANGE THESE VALUES to match your Hostinger VPS setup <<<

# Mode
VITE_APP_ENV=production

# Backend API server URL (without /api/v1)
# Example: https://api.yourdomain.com  OR  https://yourdomain.com
VITE_BACKEND_URL=https://gymdeskpro.in

# Full API base URL (with /api/v1)
VITE_API_URL=https://api.gymdeskpro.in/api/v1

# Disable debug logs in production
VITE_ENABLE_DEBUG=false

# App title shown in browser tab
VITE_APP_TITLE=GymPro
